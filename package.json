{
  "name": "eslint-plugin-llm-core-monorepo",
  "private": true,
  "description": "Monorepo for eslint-plugin-llm-core and related tooling",
  "license": "MIT",
  "author": "Rob Simpson <rsimpson2@me.com>",
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace eslint-plugin-llm-core run build && npm --workspace eslint-plugin-llm-core-mcp run build && npm --workspace llm-core-quality run build",
    "build:core": "npm --workspace eslint-plugin-llm-core run build",
    "build:quality": "npm --workspace llm-core-quality run build",
    "eval": "tsx evals/src/run-eval.ts",
    "eval:treatment": "tsx evals/src/run-eval.ts --mode treatment",
    "eval:control": "tsx evals/src/run-eval.ts --mode control",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --workspace eslint-plugin-llm-core test && npm --workspace eslint-plugin-llm-core-mcp test && npm --workspace llm-core-quality test",
    "test:core": "npm --workspace eslint-plugin-llm-core test",
    "test:watch": "npm --workspace eslint-plugin-llm-core run test:watch",
    "test:coverage": "npm --workspace eslint-plugin-llm-core run test:coverage && npm --workspace eslint-plugin-llm-core-mcp test && npm --workspace llm-core-quality test",
    "update:eslint-docs": "npm --workspace eslint-plugin-llm-core run update:eslint-docs",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript-eslint/rule-tester": "^8.64.0",
    "@typescript-eslint/utils": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-doc-generator": "^3.3.2",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.2",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.2"
  }
}
