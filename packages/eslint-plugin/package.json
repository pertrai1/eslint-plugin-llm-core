{
  "name": "eslint-plugin-llm-core",
  "version": "0.35.1",
  "description": "ESLint rules that catch the patterns LLM agents get wrong — and teach them to self-correct",
  "license": "MIT",
  "author": "Rob Simpson <rsimpson2@me.com>",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./instructions": {
      "types": "./dist/instructions/index.d.ts",
      "import": "./dist/instructions/index.js",
      "require": "./dist/instructions/index.js"
    }
  },
  "bin": {
    "llm-core-instructions": "./dist/cli/generate-instructions.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "llm",
    "ai",
    "linting",
    "typescript",
    "code-quality",
    "static-analysis",
    "chatgpt",
    "copilot",
    "claude",
    "ai-generated-code"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pertrai1/eslint-plugin-llm-core.git"
  },
  "homepage": "https://github.com/pertrai1/eslint-plugin-llm-core#readme",
  "bugs": {
    "url": "https://github.com/pertrai1/eslint-plugin-llm-core/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "eval": "tsx ../../evals/src/run-eval.ts",
    "eval:treatment": "tsx ../../evals/src/run-eval.ts --mode treatment",
    "eval:control": "tsx ../../evals/src/run-eval.ts --mode control",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "update:eslint-docs": "eslint-doc-generator --config-emoji all,🌐 --config-emoji best-practices,🏆 --config-emoji complexity,🧮 --config-emoji hygiene,🧹 --config-emoji recommended,✅ --config-emoji style,🎨 --config-emoji typescript,⌨️ --ignore-config bestPractices && prettier --write README.md \"docs/rules/**/*.md\""
  },
  "peerDependencies": {
    "@typescript-eslint/utils": "^8.66.0",
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript-eslint/rule-tester": "^8.66.0",
    "@typescript-eslint/utils": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-doc-generator": "^3.3.2",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.2"
  }
}
