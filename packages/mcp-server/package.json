{
  "name": "eslint-plugin-llm-core-mcp",
  "version": "0.29.6",
  "description": "MCP server for just-in-time linting guidance from eslint-plugin-llm-core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pertrai1/eslint-plugin-llm-core",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "llm-core-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "embed": "tsx scripts/embed-rule-docs.ts",
    "build:plugin": "npm --workspace eslint-plugin-llm-core run build",
    "prebuild": "npm run build:plugin && npm run embed",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run embed",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build:plugin",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-llm-core": "0.36.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
